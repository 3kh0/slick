{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    "jsx": "react",

    // Slack's React is a global published by `app/slack/react.tsx`, not a bundled
    // dependency, so JSX in a module has to reach the UMD global.
    "allowUmdGlobalAccess": true,

    "paths": {
      "$slick": ["./src/shared/Plugin.ts"],
      "*": ["./*"]
    },

    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts"],
  "exclude": ["node_modules", "byoe", "dist", "work", "plugins", "runtime"]
}
