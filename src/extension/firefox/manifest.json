{
  "manifest_version": 3,
  "name": "Slick for Firefox",
  "version": "0.0.0",
  "description": "Experimental Slick themes and plugins for the Slack web client.",
  "homepage_url": "https://github.com/3kh0/slick",
  "browser_specific_settings": {
    "gecko": {
      "id": "slick@3kh0.net",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/3kh0/slick/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://app.slack.com/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/client", "https://app.slack.com/client/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://app.slack.com/client", "https://app.slack.com/client/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Slick settings",
    "default_popup": "options.html?popup",
    "default_icon": {
      "16": "icons/black.svg",
      "32": "icons/black.svg"
    },
    "theme_icons": [
      {
        "light": "icons/white.svg",
        "dark": "icons/black.svg",
        "size": 16
      },
      {
        "light": "icons/white.svg",
        "dark": "icons/black.svg",
        "size": 32
      }
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
