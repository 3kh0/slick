{
  "name": "slick",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:sh": "git ls-files '*.sh' | xargs shellcheck -S warning",
    "render": "scripts/icon/render-icon.sh",
    "test:app": "node --experimental-strip-types --test \"src/{app,desktop,plugins,shared}/**/*.test.ts\"",
    "test:accounts:electron": "node scripts/test-account-navigation.ts",
    "check:electron": "node scripts/ci/electron-watch.cjs",
    "check": "npm run fmt:check && npm run lint && npm run lint:sh && npm run typecheck && npm test",
    "build": "node scripts/build.ts",
    "desktop:dev": "node scripts/desktop.ts",
    "test:extension": "node --experimental-strip-types --test \"src/extension/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "extension:lint": "web-ext lint --source-dir dist/extension/firefox --self-hosted --warnings-as-errors",
    "extension:dev": "web-ext run --source-dir dist/extension/firefox --start-url https://app.slack.com/client",
    "typecheck": "node scripts/generate-main-plugins.ts && tsc --noEmit",
    "extension:build": "node scripts/build.ts firefox chromium",
    "extension:validate": "node scripts/validate-extension.ts",
    "test": "npm run test:app && npm run test:extension && npm run test:userscript",
    "userscript:build": "node scripts/build.ts userscript",
    "test:userscript": "node --experimental-strip-types --test \"src/userscript/**/*.test.ts\""
  },
  "dependencies": {
    "tar-stream": "^3.2.2",
    "xz-decompress": "^0.2.3"
  },
  "devDependencies": {
    "@fontsource/lato": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/tar-stream": "^3.1.5",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "monaco-editor": "0.57.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "web-ext": "^10.7.0"
  }
}
