# Maintainer: Slick contributors
pkgname=slick-bin
pkgver=2.0.100
pkgrel=1
pkgdesc='Slack client mod (requires separately installed official Slack)'
arch=('x86_64')
url='https://github.com/3kh0/slick'
license=('GPL-3.0-only')
depends=('slack')
provides=('slick')
conflicts=('slick' 'slick-git')
source=("Slick-${pkgver}-linux-x64.tar.gz::https://github.com/3kh0/slick/releases/download/v${pkgver##*.}/Slick-${pkgver}-linux-x64.tar.gz"
        'dev.slick.Slick.desktop' 'icon.png')
sha256sums=('REPLACE_WITH_RELEASE_SHA256'
            '98654abf868cdc3465dd4946a2698e64916bb2ef99b449dbabfd5afc84c8d6ec'
            '11ad06c58420978f5403a8fd9ca521ea0bf4742ae5fb3ba649f490c794550b2d')

package() {
  install -dm755 "$pkgdir/opt/slick" "$pkgdir/usr/bin"
  cp -a Slick/. "$pkgdir/opt/slick/"
  ln -s /opt/slick/slick "$pkgdir/usr/bin/slick"
  install -Dm644 "$srcdir/dev.slick.Slick.desktop" "$pkgdir/usr/share/applications/dev.slick.Slick.desktop"
  install -Dm644 "$srcdir/icon.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/dev.slick.Slick.png"
}
