  "css": [
    "body::before{content:'';position:fixed;inset:0;z-index:0;background:#2e3440;pointer-events:none;}",
    ".p-theme_background{background:#2e3440 !important;}",
    ".p-theme_background:after{backdrop-filter:none !important;background:#2e3440 !important;}",
    ".p-view_contents--sidebar{background:#3b4252 !important;}",
    ".sk-client-theme--dark .c-message_list__unread_divider--unread_threads .c-message_list__unread_divider__label,.p-thread_separator_row_generic--dark .p-threads_flexpane__unread_divider__label,.p-thread_separator_row_generic--dark .p-threads_flexpane__read_divider__label{color:#bf616a !important;}",
    ".c-tabs__tab_menu--vertical .c-tabs__tab.c-tabs__tab--active,.c-tabs__tab_menu--vertical .c-tabs__tab:active{background-color:#81a1c1 !important;color:#2e3440 !important;}",
    "input[type=checkbox],input[type=radio],progress{accent-color:#81a1c1;}",
    "::selection{background:rgba(216,222,233,0.3);}",
    ".c-button--primary,.c-icon_button--primary,.c-icon_button--primary:link,[class*=sendButtonActive__],[class*=joinButton__],[class*=primaryCtaPrimary__]{background-color:#a3be8c !important;color:#2e3440 !important;}",
    ".c-button--primary:hover,.c-icon_button--primary:hover{background-color:#8fbcbb !important;}",
    "[data-qa=huddle_toolbar__leave_button]{background-color:#bf616a !important;color:#2e3440 !important;}",
    "[data-qa=huddle_toolbar__leave_button]:hover{background-color:#d08770 !important;}",
    ".c-mrkdwn__code,.c-texty_input code,.c-wysiwyg_container--theme_dark code,.c-pillow_file__post__content code{color:#d08770 !important;}",
    ".c-message--pinned .c-message__label__icon,.c-message_kit__labels--pinned .c-message_kit__labels__icon,.p-drafts_page__draft_badge{color:#d08770 !important;}",
    ".sk-client-theme--dark .c-reaction--reacted,.sk-client-theme--dark .c-reaction--reacted:hover{background-color:rgba(129,161,193,0.18) !important;box-shadow:0 0 0 1px #81a1c1 !important;}",
    ".sk-client-theme--dark .c-reaction--reacted .c-reaction__count{color:#81a1c1 !important;}",
    ".p-message_input__input_container_unstyled,.c-wysiwyg_container--theme_dark{background-color:#3b4252 !important;border:1px solid #4c566a !important;}",
    ".c-wysiwyg_container__formatting{background:#3b4252 !important;}",
    ".p-context_bar_v2,[data-qa=context_bar]{background:#3b4252 !important;border:1px solid #4c566a !important;}",
    ".p-context_bar_v2__content,.p-context_bar_v2__icon{color:#e5e9f0 !important;}",
    "[role=menu],[role=dialog],[role=listbox],.c-menu,.p-ia4_floating_window,.c-popover__content{background-color:#3b4252 !important;border:1px solid #434c5e !important;}",
    ".c-message_kit__background--hovered:not(.c-message_kit__background--highlight):not(.c-message_kit__background--editing):not(.c-message_kit__background--huddle):not(.c-message_kit__background--deleting){background:#434c5e !important;}",
    ".c-message:hover:not(.c-message--highlight):not(.c-message--standalone):not(.c-message--pinned):not(.c-message--ephemeral):not(.c-message--custom_response):not(.c-message--starred),.c-message--hover:not(.c-message--highlight):not(.c-message--standalone):not(.c-message--pinned):not(.c-message--ephemeral):not(.c-message--custom_response):not(.c-message--starred){background:#434c5e !important;}",
    ".p-about_modal__contents{background:#3b4252 !important;border:1px solid #434c5e !important;}",
    ".p-member_profile_hover_card__container_deleted{background:#3b4252 !important;border:1px solid #434c5e !important;}",
    ".p-member_profile_hover_card__banner_deactivated_dark,.p-member_profile_hover_card__banner_deactivated_light,.p-member_profile_restriction_deleted,.p-member_profile_hover_card__container_deleted .c-avatar{background:#434c5e !important;}",
    ".p-view_header:has(~ * > .p-outbox_page__tab-menu),.p-outbox_page__tab-menu,.p-drafts_page,.p-sent_page{background:#2e3440 !important;}",
    ".p-view_header:has(~ * > .p-threads_view),.p-threads_view{background:#2e3440 !important;}",
    ".c-virtual_list__item:has(> [data-qa=reply_container]),.c-virtual_list__item > [data-qa=reply_container],.c-virtual_list__item > [data-qa=reply_container] > .p-threads_footer__input{background:#2e3440 !important;}",
    ".p-view_header_star_action_button_filled{background-color:#3b4252 !important;color:#ebcb8b !important;stroke:#ebcb8b !important;}",
    ".p-view_header_star_action_button_filled:hover{background-color:#434c5e !important;}",
    ".c-base_inline_entity--highlight-dark,.c-base_list_entity--highlight-dark,.c-select_options_list__option--active,.c-date_picker_calendar__date--is_selected,.c-date_range_picker_calendar__date--select_range_start,.c-date_range_picker_calendar__date--select_range_end,.c-texty_autocomplete__result--selected,.c-search_autocomplete__suggestion_item--selected,.c-search_autocomplete__guided_search_item--hover:hover,.c-search_autocomplete__guided_search_item--selected,.c-search_autocomplete__quick_message_item--selected{background-color:var(--dt_color-base-inv-hgl-1) !important;color:#fff !important;}",
    ".p-new_threads_banner,.p-threads_view [class^=banner__],.p-threads_view [class^=dismiss__],.p-message_pane__unread_banner,.p-message_pane__unread_banner__banner:hover,.p-message_pane__unread_banner__close--detached,.p-archives_banner,.p-archives_banner:hover{background:var(--dt_color-base-inv-hgl-1) !important;color:#fff !important;}"
  ]
}
