  "css": [
    "body::before{content:'';position:fixed;inset:0;z-index:0;background:#11111b;pointer-events:none;}",
    ".p-theme_background{background:#11111b !important;}",
    ".p-theme_background:after{backdrop-filter:none !important;background:#11111b !important;}",
    ".p-view_contents--sidebar{background:#181825 !important;}",
    ".sk-client-theme--dark .c-message_list__unread_divider--unread_threads .c-message_list__unread_divider__label,.p-thread_separator_row_generic--dark .p-threads_flexpane__unread_divider__label,.p-thread_separator_row_generic--dark .p-threads_flexpane__read_divider__label{color:#f38ba8 !important;}",
    ".c-tabs__tab_menu--vertical .c-tabs__tab.c-tabs__tab--active,.c-tabs__tab_menu--vertical .c-tabs__tab:active{background-color:#cba6f7 !important;color:#11111b !important;}",
    "input[type=checkbox],input[type=radio],progress{accent-color:#cba6f7;}",
    "::selection{background:rgba(147,153,178,0.3);}",
    ".c-button--primary,.c-icon_button--primary,.c-icon_button--primary:link,[class*=sendButtonActive__],[class*=joinButton__],[class*=primaryCtaPrimary__]{background-color:#a6e3a1 !important;color:#11111b !important;}",
    ".c-button--primary:hover,.c-icon_button--primary:hover{background-color:#94e2d5 !important;}",
    ".c-mrkdwn__code,.c-texty_input code,.c-wysiwyg_container--theme_dark code,.c-pillow_file__post__content code{color:#fab387 !important;}",
    ".c-message--pinned .c-message__label__icon,.c-message_kit__labels--pinned .c-message_kit__labels__icon,.p-drafts_page__draft_badge{color:#fab387 !important;}",
    ".sk-client-theme--dark .c-reaction--reacted,.sk-client-theme--dark .c-reaction--reacted:hover{background-color:rgba(203,166,247,0.18) !important;box-shadow:0 0 0 1px #cba6f7 !important;}",
    ".sk-client-theme--dark .c-reaction--reacted .c-reaction__count{color:#cba6f7 !important;}",
    ".p-message_input__input_container_unstyled,.c-wysiwyg_container--theme_dark{background-color:#181825 !important;border:1px solid #45475a !important;}",
    ".c-wysiwyg_container__formatting{background:#181825 !important;}",
    ".p-context_bar_v2,[data-qa=context_bar]{background:#181825 !important;border:1px solid #45475a !important;}",
    ".p-context_bar_v2__content,.p-context_bar_v2__icon{color:#bac2de !important;}",
    "[role=menu],[role=dialog],[role=listbox],.c-menu,.p-ia4_floating_window,.c-popover__content{background-color:#181825 !important;border:1px solid #313244 !important;}",
    ".c-message_kit__background--hovered:not(.c-message_kit__background--highlight):not(.c-message_kit__background--editing):not(.c-message_kit__background--huddle):not(.c-message_kit__background--deleting){background:#28283a !important;}",
    ".c-message:hover:not(.c-message--highlight):not(.c-message--standalone):not(.c-message--pinned):not(.c-message--ephemeral):not(.c-message--custom_response):not(.c-message--starred),.c-message--hover:not(.c-message--highlight):not(.c-message--standalone):not(.c-message--pinned):not(.c-message--ephemeral):not(.c-message--custom_response):not(.c-message--starred){background:#28283a !important;}",
    ".p-about_modal__contents{background:#181825 !important;border:1px solid #313244 !important;}",
    ".p-member_profile_hover_card__container_deleted{background:#181825 !important;border:1px solid #313244 !important;}",
    ".p-member_profile_hover_card__banner_deactivated_dark,.p-member_profile_hover_card__banner_deactivated_light,.p-member_profile_restriction_deleted,.p-member_profile_hover_card__container_deleted .c-avatar{background:#313244 !important;}",
    ".p-view_contents--primary:has([data-qa^=outbox_tab_]) .p-view_header,.p-outbox_page__tab-menu,.p-drafts_page,.p-sent_page{background:#1e1e2e !important;}",
    ".p-view_contents--primary:has([data-qa=threads_view]) .p-view_header,.p-threads_view{background:#1e1e2e !important;}"
  ]
