  "css": [
    "body::before{content:'';position:fixed;inset:0;z-index:0;background:#262b3c;pointer-events:none;}",
    ".p-theme_background{background:#262b3c !important;}",
    ".p-theme_background:after{backdrop-filter:none !important;background:#262b3c !important;}",
    ".p-view_contents--sidebar{background:#2e3449 !important;}",
    ".sk-client-theme--dark .c-message_list__unread_divider--unread_threads .c-message_list__unread_divider__label,.p-thread_separator_row_generic--dark .p-threads_flexpane__unread_divider__label,.p-thread_separator_row_generic--dark .p-threads_flexpane__read_divider__label{color:#ff617b !important;}",
    ".c-tabs__tab_menu--vertical .c-tabs__tab.c-tabs__tab--active,.c-tabs__tab_menu--vertical .c-tabs__tab:active{background-color:#899de7 !important;color:#262b3c !important;}",
    "input[type=checkbox],input[type=radio],progress{accent-color:#899de7;}",
    "::selection{background:rgba(147,157,183,0.3);}",
    ".c-button--primary,.c-icon_button--primary,.c-icon_button--primary:link,[class*=sendButtonActive__],[class*=joinButton__],[class*=primaryCtaPrimary__]{background-color:#899de7 !important;color:#152664 !important;}",
    ".c-button--primary:hover,.c-icon_button--primary:hover{background-color:#424c69 !important;}",
    "[data-qa=huddle_toolbar__leave_button]{background-color:#ff617b !important;color:#262b3c !important;}",
    "[data-qa=huddle_toolbar__leave_button]:hover{background-color:#a6b7f4 !important;}",
    ".c-mrkdwn__code,.c-texty_input code,.c-wysiwyg_container--theme_dark code,.c-pillow_file__post__content code{color:#a6b7f4 !important;}",
