    ".p-tab_rail__button .c-tabs__tab_content{height:100% !important;min-height:0 !important;width:100% !important;padding:0 !important;background:transparent !important;border-radius:inherit !important;box-shadow:none !important;}",
    ".p-tab_rail__button__icon{background:transparent !important;border:0 !important;box-shadow:none !important;border-radius:0 !important;}",
    ".p-tab_rail__button--active{background:var(--slick-material-accent) !important;}",
    ".p-tab_rail__button .p-unread_dot{top:1px !important;right:1px !important;bottom:auto !important;left:auto !important;transform:none !important;z-index:1;}",
    ".p-ia__main_menu__user{padding:10px !important;align-items:center !important;gap:12px !important;}",
    ".p-ia__main_menu__user .p-ia__nav__user{display:flex !important;align-items:center !important;flex-shrink:0;}",
    ".p-ia__main_menu__user__details{margin:0 !important;min-width:0;}",
    ".p-ia__main_menu__user__presence{margin:0 !important;padding:0 !important;align-items:center !important;line-height:20px !important;}",
    ".p-ia__main_menu__custom_status_item{margin:4px 10px 8px !important;}",
    ".p-ia__main_menu__custom_status_button{background:var(--slick-material-elevated) !important;border:0 !important;border-radius:12px !important;padding:8px 36px 8px 10px !important;min-height:36px !important;box-sizing:border-box !important;}",
    ".p-ia__main_menu__custom_status_icon{width:24px !important;min-width:24px !important;margin-right:8px !important;}",
    ".p-ia__main_menu__custom_status_icon__part{right:2px !important;}",
    ".p-ia__main_menu__custom_status_text{line-height:20px !important;}",
    ".p-ia__main_menu__custom_status_item__clear{width:28px !important;height:28px !important;padding:0 !important;right:4px !important;top:50% !important;transform:translateY(-50%) !important;border-radius:50% !important;justify-content:center !important;}",
    ".c-menu_separator__li{padding:0 !important;margin:8px 10px !important;}"
  ]
}
