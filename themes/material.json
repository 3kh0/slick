    ".p-view_header:has(~ * > .p-outbox_page__tab-menu),.p-outbox_page__tab-menu,.p-drafts_page,.p-sent_page{background:#262b3c !important;}",
    ".p-view_header:has(~ * > .p-threads_view),.p-threads_view{background:#262b3c !important;}",
