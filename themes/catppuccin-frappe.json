  "css": [
    "body::before{content:'';position:fixed;inset:0;z-index:0;background:#232634;pointer-events:none;}",
    ".p-theme_background{background:#232634 !important;}",
    ".p-theme_background:after{backdrop-filter:none !important;background:#232634 !important;}",
    ".p-view_contents--sidebar{background:#292c3c !important;}",
    ".sk-client-theme--dark .c-message_list__unread_divider--unread_threads .c-message_list__unread_divider__label,.p-thread_separator_row_generic--dark .p-threads_flexpane__unread_divider__label,.p-thread_separator_row_generic--dark .p-threads_flexpane__read_divider__label{color:#e78284 !important;}",
    ".c-tabs__tab_menu--vertical .c-tabs__tab.c-tabs__tab--active,.c-tabs__tab_menu--vertical .c-tabs__tab:active{background-color:#ca9ee6 !important;color:#232634 !important;}",
    "input[type=checkbox],input[type=radio],progress{accent-color:#ca9ee6;}",
    "::selection{background:rgba(165,173,206,0.3);}",
    ".c-button--primary,.c-icon_button--primary,.c-icon_button--primary:link,[class*=sendButtonActive__],[class*=joinButton__],[class*=primaryCtaPrimary__]{background-color:#a6d189 !important;color:#232634 !important;}",
    ".c-button--primary:hover,.c-icon_button--primary:hover{background-color:#81c8be !important;}",
    "[data-qa=huddle_toolbar__leave_button]{background-color:#e78284 !important;color:#232634 !important;}",
    "[data-qa=huddle_toolbar__leave_button]:hover{background-color:#eba0ac !important;}",
    ".c-mrkdwn__code,.c-texty_input code,.c-wysiwyg_container--theme_dark code,.c-pillow_file__post__content code{color:#ef9f76 !important;}",
    ".c-message--pinned .c-message__label__icon,.c-message_kit__labels--pinned .c-message_kit__labels__icon,.p-drafts_page__draft_badge{color:#ef9f76 !important;}",
    ".sk-client-theme--dark .c-reaction--reacted,.sk-client-theme--dark .c-reaction--reacted:hover{background-color:rgba(202,158,230,0.18) !important;box-shadow:0 0 0 1px #ca9ee6 !important;}",
    ".sk-client-theme--dark .c-reaction--reacted .c-reaction__count{color:#ca9ee6 !important;}",
    ".p-message_input__input_container_unstyled,.c-wysiwyg_container--theme_dark{background-color:#292c3c !important;border:1px solid #51576d !important;}",
    ".c-wysiwyg_container__formatting{background:#292c3c !important;}",
    ".p-context_bar_v2,[data-qa=context_bar]{background:#292c3c !important;border:1px solid #51576d !important;}",
    ".p-context_bar_v2__content,.p-context_bar_v2__icon{color:#b5bfe2 !important;}",
    "[role=menu],[role=dialog],[role=listbox],.c-menu,.p-ia4_floating_window,.c-popover__content{background-color:#292c3c !important;border:1px solid #414559 !important;}",
    ".c-message_kit__background--hovered:not(.c-message_kit__background--highlight):not(.c-message_kit__background--editing):not(.c-message_kit__background--huddle):not(.c-message_kit__background--deleting){background:#28283a !important;}",
    ".c-message:hover:not(.c-message--highlight):not(.c-message--standalone):not(.c-message--pinned):not(.c-message--ephemeral):not(.c-message--custom_response):not(.c-message--starred),.c-message--hover:not(.c-message--highlight):not(.c-message--standalone):not(.c-message--pinned):not(.c-message--ephemeral):not(.c-message--custom_response):not(.c-message--starred){background:#28283a !important;}",
    ".p-about_modal__contents{background:#292c3c !important;border:1px solid #414559 !important;}",
    ".p-member_profile_hover_card__container_deleted{background:#292c3c !important;border:1px solid #414559 !important;}",
    ".p-member_profile_hover_card__banner_deactivated_dark,.p-member_profile_hover_card__banner_deactivated_light,.p-member_profile_restriction_deleted,.p-member_profile_hover_card__container_deleted .c-avatar{background:#414559 !important;}",
    ".p-view_header:has(~ * > .p-outbox_page__tab-menu),.p-outbox_page__tab-menu,.p-drafts_page,.p-sent_page{background:#303446 !important;}",
    ".p-view_header:has(~ * > .p-threads_view),.p-threads_view{background:#303446 !important;}",
    ".c-virtual_list__item:has(> [data-qa=reply_container]),.c-virtual_list__item > [data-qa=reply_container],.c-virtual_list__item > [data-qa=reply_container] > .p-threads_footer__input{background:#303446 !important;}"
  ]
