  "css": [
    "body{font-family:Papyrus,\"Comic Sans MS\",\"Chalkboard SE\",fantasy !important;font-size:17px !important;}",
    "body::before{content:\"\";position:fixed;inset:0;pointer-events:none;background:repeating-conic-gradient(#ff00cc 0% 25%,#00ffff 0% 50%) 0 0/28px 28px;}",
    ".p-theme_background{background:repeating-linear-gradient(135deg,#ff00cc 0 20px,#ffff00 20px 40px,#00ffff 40px 60px) !important;}",
    ".p-theme_background:after{background:transparent !important;backdrop-filter:none !important;}",
    ".p-view_contents--sidebar{background:repeating-linear-gradient(18deg,#b6ff00 0 38px,#00ffff 38px 76px,#ff69b4 76px 114px) !important;border:7px ridge #9900ff !important;border-radius:45px 3px 70px 12px !important;}",
    ".p-channel_sidebar{font-family:\"Comic Sans MS\",\"Chalkboard SE\",cursive !important;}",
    ".p-channel_sidebar__channel,.p-channel_sidebar__link{font-size:17px !important;border-radius:3px 24px 6px 35px !important;}",
    ".p-channel_sidebar__channel:nth-of-type(3n){font-family:Papyrus,fantasy !important;font-size:22px !important;color:#9900cc !important;}",
    ".p-channel_sidebar__channel:nth-of-type(3n + 1){font-size:13px !important;color:#0000cc !important;}",
    ".p-channel_sidebar__channel--selected,.p-channel_sidebar__link--selected{background:#ffff00 !important;color:#9900cc !important;outline:3px dotted #ff00cc !important;}",
    ".p-channel_sidebar__section_heading{font-family:Papyrus,fantasy !important;font-size:23px !important;text-shadow:2px 1px #ffff00 !important;}",
    ".p-top_nav__search{background:#ffff00 !important;color:#9900cc !important;border:4px dashed #ff00cc !important;border-radius:50% 9px 35% 6px !important;font-family:\"Comic Sans MS\",cursive !important;}",
    ".p-view_header,.p-outbox_page__tab-menu{background:linear-gradient(90deg,#00ffff,#ff69b4,#ffff00) !important;border-bottom:6px dotted #9900ff !important;}",
    ".p-view_header{font-family:Papyrus,fantasy !important;text-shadow:2px 2px #b6ff00 !important;}",
    ".p-message_pane,.p-threads_view,.p-drafts_page,.p-sent_page{background:repeating-linear-gradient(0deg,#fff1a8 0 27px,#ffffc7 27px 29px) !important;}",
    ".c-message_kit__message,.c-message{border-left:5px dotted #ff00cc !important;}",
    ".c-virtual_list__item:nth-child(3n) .c-message_kit__text{font-family:\"Comic Sans MS\",cursive !important;font-size:19px !important;color:#9900cc !important;}",
    ".c-virtual_list__item:nth-child(3n + 1) .c-message_kit__text{font-family:Papyrus,fantasy !important;font-size:16px !important;color:#0000cc !important;}",
    ".c-virtual_list__item:nth-child(3n + 2) .c-message_kit__text{font-family:\"Courier New\",monospace !important;font-size:21px !important;color:#aa0044 !important;}",
    ".c-message_kit__sender,.c-message__sender{font-family:Papyrus,fantasy !important;font-size:23px !important;text-shadow:2px 1px #00ffff !important;}",
    ".c-button,.c-icon_button,.c-tabs__tab{font-family:\"Comic Sans MS\",\"Chalkboard SE\",cursive !important;}",
    ".c-button{background:#ff69b4 !important;color:#330066 !important;border:4px outset #b6ff00 !important;border-radius:2px 25px 8px 35px !important;box-shadow:4px 4px 0 #9900ff !important;}",
    ".c-button:nth-of-type(2n){border-radius:50% 6px 40% 3px !important;transform:rotate(-2deg);}",
    ".c-button--primary{background:#b6ff00 !important;color:#9900cc !important;font-size:19px !important;}",
    ".c-button:hover{background:#ffff00 !important;color:#9900cc !important;}",
    ".c-tabs__tab--active{background:#ffff00 !important;color:#9900cc !important;border:3px dashed #ff00cc !important;border-radius:20px 2px 25px 5px !important;}",
    ".c-tabs__tab:nth-of-type(3n){font-family:Papyrus,fantasy !important;font-size:19px !important;}",
    ".p-message_input__input_container_unstyled,.c-wysiwyg_container{background:#00ffff !important;border:6px ridge #ff00cc !important;border-radius:30px 0 40px 4px !important;}",
    ".ql-editor{font-family:\"Comic Sans MS\",\"Chalkboard SE\",cursive !important;font-size:20px !important;color:#9900cc !important;}",
    ".c-wysiwyg_container__formatting{background:#ffff00 !important;border-top:4px dotted #9900ff !important;}",
    "[role=menu],[role=listbox],.c-menu,.c-popover__content{background:#b6ff00 !important;color:#330066 !important;border:6px double #ff00cc !important;border-radius:3px 40px 5px 22px !important;box-shadow:8px 8px 0 #9900ff !important;}",
    "[role=dialog],.p-prefs_dialog__modal{background:#fff1a8 !important;border:8px ridge #ff00cc !important;border-radius:45px 0 65px 9px !important;box-shadow:10px 10px 0 #00ffff !important;}",
    ".p-prefs_dialog__header{background:linear-gradient(90deg,#ffff00,#ff69b4,#00ffff) !important;border-bottom:5px dashed #9900ff !important;}",
    ".p-prefs_dialog__title{font-family:Papyrus,fantasy !important;font-size:34px !important;color:#9900cc !important;text-shadow:3px 2px #b6ff00 !important;}",
    ".c-input_text,.c-select_input,.c-filter_input{background:#ffff00 !important;color:#330066 !important;border:3px dashed #9900ff !important;border-radius:18px 0 22px 2px !important;}",
    ".c-reaction{background:#ff69b4 !important;border:3px dotted #0000cc !important;border-radius:40% 4px 50% 2px !important;}",
    ".c-reaction__count{font-family:\"Comic Sans MS\",cursive !important;color:#330066 !important;}",
    ".c-mrkdwn a,.c-link{color:#9900cc !important;text-decoration:underline wavy #ff6600 !important;}",
    ".c-mrkdwn__code,.c-texty_input code{font-family:Papyrus,fantasy !important;background:#b6ff00 !important;color:#aa0044 !important;border:2px dotted #ff00cc !important;}",
    ".slick-settings__theme{border:4px dashed #9900ff !important;border-radius:32px 2px 55px 5px !important;}",
    "input[type=checkbox],input[type=radio],progress{accent-color:#ff00cc;}",
    "::selection{background:#ff00cc;color:#ffff00;}"
  ]
}
