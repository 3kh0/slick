{
  "name": "Verdant Circuit - By @Jacob N",
  "description": "A deep graphite Slack theme with electric fern-green highlights, restrained glow, and readable native text.",
  "palette": {
    "highlight1": {
      "100": "33,140,90",
      "200": "42,169,108",
      "300": "91,227,162"
    },
    "highlight2": {
      "100": "33,140,90",
      "200": "42,169,108"
    }
  },
  "sidebar": {
    "nav-bg": "#0b1b11",
    "text-color": "#f5f5f5",
    "badge": "#2aa96c",
    "badge-text-color": "#07110b"
  },
  "vars": {
    "--dt_color-base-pry": "#0b120d",
    "--dt_color-base-sec": "#0d1710",
    "--dt_color-base-ter": "#112018",
    "--dt_color-base-inv-pry": "#12271a",
    "--dt_color-ctr-pry": "#101d14",
    "--dt_color-ctr-sec": "#14271a",
    "--dt_color-base-modal": "rgba(13,24,16,0.98)",
    "--dt_color-base-pry-hover": "rgba(42,169,108,0.09)",
    "--dt_color-base-pry-pressed": "rgba(42,169,108,0.16)",
    "--dt_color-base-sec-hover": "rgba(42,169,108,0.09)",
    "--dt_color-base-sec-pressed": "rgba(42,169,108,0.16)",
    "--dt_color-base-ter-hover": "rgba(42,169,108,0.10)",
    "--dt_color-base-ter-pressed": "rgba(42,169,108,0.18)",
    "--sk_primary_background": "11,18,13",
    "--dt_color-content-hgl-1": "#5be3a2",
    "--dt_color-content-inv-hgl-1": "#5be3a2",
    "--dt_color-otl-hgl-1": "#2aa96c",
    "--dt_color-otl-hgl-1-sec": "rgba(42,169,108,0.45)",
    "--dt_color-base-hgl-1": "rgba(33,140,90,0.24)",
    "--dt_color-base-hgl-1-hover": "rgba(42,169,108,0.30)",
    "--dt_color-base-hgl-1-pressed": "rgba(42,169,108,0.38)",
    "--dt_color-surf-hgl-1": "rgba(42,169,108,0.22)",
    "--dt_color-surf-hgl-1-hover": "rgba(42,169,108,0.30)",
    "--dt_color-surf-hgl-1-pressed": "rgba(42,169,108,0.38)",
    "--sk_highlight": "33,140,90",
    "--sk_highlight_accent": "42,169,108",
    "--sk_highlight_hover": "91,227,162",
    "--sk_menu-item_highlight-background": "rgba(33,140,90,0.22)",
    "--sk_menu-item_highlight-color": "#f5f5f5",
    "--selection-box-shadow-color": "rgba(42,169,108,0.38)",
    "--TextyTheme-wysiwyg-border-color": "rgba(42,169,108,0.36)",
    "--TextyTheme-send-bg": "#218c5a",
    "--TextyTheme-send-bg-hover": "#2aa96c",
    "--TextyTheme-send-fg": "#ffffff"
  },
  "css": [
    "html,body{background:#0b120d !important;}",
    ".p-theme_background{background:radial-gradient(ellipse at 88% 0%,rgba(33,140,90,0.12),transparent 35%),#0b120d !important;}",
    ".p-theme_background:after{background:#0b120d !important;backdrop-filter:none !important;}",
    ".p-view_contents--sidebar{background:linear-gradient(180deg,#0b1b11 0%,#0d1710 55%,#0a120d 100%) !important;border-right:1px solid rgba(42,169,108,0.24) !important;}",
    ".p-workspace__header,.p-header,.p-view_header{background:rgba(11,24,15,0.94) !important;border-bottom:1px solid rgba(42,169,108,0.22) !important;}",
    ".p-channel_sidebar__channel--selected,.p-channel_sidebar__link--selected,.p-channel_sidebar__channel[aria-current=page],.p-channel_sidebar__link[aria-current=page]{background:linear-gradient(90deg,rgba(33,140,90,0.38),rgba(33,140,90,0.15)) !important;box-shadow:inset 3px 0 0 #2aa96c,0 0 18px rgba(33,140,90,0.06) !important;border-radius:8px !important;}",
    ".p-channel_sidebar__channel:hover,.p-channel_sidebar__link:hover{background:rgba(42,169,108,0.12) !important;border-radius:8px !important;}",
    ".p-channel_sidebar__section_heading{color:#86d9ae !important;}",
    ".c-tabs__tab_menu--vertical .c-tabs__tab.c-tabs__tab--active,.c-tabs__tab_menu--vertical .c-tabs__tab:active{background:linear-gradient(135deg,#218c5a,#2aa96c) !important;color:#ffffff !important;border-radius:8px !important;box-shadow:0 3px 14px rgba(33,140,90,0.22) !important;}",
    ".c-button--primary,.c-icon_button--primary,.c-icon_button--primary:link,[class*=sendButtonActive__],[class*=joinButton__],[class*=primaryCtaPrimary__]{background:linear-gradient(135deg,#218c5a,#2aa96c) !important;border-color:#2aa96c !important;color:#ffffff !important;}",
    ".c-button--primary:hover,.c-icon_button--primary:hover,.c-icon_button--primary:link:hover,[class*=sendButtonActive__]:hover,[class*=joinButton__]:hover,[class*=primaryCtaPrimary__]:hover{background:linear-gradient(135deg,#2aa96c,#3ac982) !important;border-color:#5be3a2 !important;color:#ffffff !important;box-shadow:0 4px 18px rgba(33,140,90,0.22) !important;}",
    ".p-message_input__input_container_unstyled,.c-wysiwyg_container--theme_dark{background:linear-gradient(150deg,#13251a,#101c14) !important;border:1px solid rgba(42,169,108,0.42) !important;border-radius:12px !important;}",
    ".p-message_input__input_container_unstyled:focus-within,.c-wysiwyg_container--theme_dark:focus-within{border-color:#2aa96c !important;box-shadow:0 0 0 3px rgba(42,169,108,0.16),0 10px 30px rgba(0,0,0,0.18) !important;}",
    ".c-wysiwyg_container__formatting{background:#112018 !important;border-top:1px solid rgba(42,169,108,0.20) !important;}",
    ".c-search__input,[data-qa=search_input]{background:#122018 !important;border:1px solid rgba(42,169,108,0.32) !important;border-radius:999px !important;}",
    ".c-search__input:focus,[data-qa=search_input]:focus{border-color:#2aa96c !important;box-shadow:0 0 0 3px rgba(42,169,108,0.14) !important;}",
    ".p-context_bar_v2,[data-qa=context_bar]{background:linear-gradient(135deg,#14271a,#102017) !important;border:1px solid rgba(42,169,108,0.32) !important;}",
    ".p-context_bar_v2__content,.p-context_bar_v2__icon{color:#c8f0d8 !important;}",
    "[role=menu],[role=dialog],[role=listbox],.c-menu,.p-ia4_floating_window,.c-popover__content{background:#102017 !important;border:1px solid rgba(42,169,108,0.28) !important;box-shadow:0 18px 50px rgba(0,0,0,0.42),0 0 0 1px rgba(42,169,108,0.04) !important;}",
    ".c-menu_item:hover,[role=menuitem]:hover,[role=option]:hover{background:rgba(42,169,108,0.16) !important;}",
    ".c-message_kit__background--hovered:not(.c-message_kit__background--highlight):not(.c-message_kit__background--editing):not(.c-message_kit__background--huddle):not(.c-message_kit__background--deleting){background:rgba(42,169,108,0.075) !important;}",
    ".c-message:hover:not(.c-message--highlight):not(.c-message--standalone):not(.c-message--pinned):not(.c-message--ephemeral):not(.c-message--custom_response):not(.c-message--starred),.c-message--hover:not(.c-message--highlight):not(.c-message--standalone):not(.c-message--pinned):not(.c-message--ephemeral):not(.c-message--custom_response):not(.c-message--starred){background:rgba(42,169,108,0.075) !important;}",
    ".c-mrkdwn a,.c-link{color:#5be3a2 !important;}",
    ".c-mrkdwn a:hover,.c-link:hover{color:#8cf0bd !important;}",
    ".sk-client-theme--dark .c-reaction--reacted,.sk-client-theme--dark .c-reaction--reacted:hover{background:rgba(42,169,108,0.23) !important;box-shadow:0 0 0 1px rgba(42,169,108,0.78) !important;}",
    ".sk-client-theme--dark .c-reaction--reacted .c-reaction__count{color:#86d9ae !important;}",
    ".c-message_list__unread_divider--unread_threads .c-message_list__unread_divider__label,.p-thread_separator_row_generic--dark .p-threads_flexpane__unread_divider__label,.p-thread_separator_row_generic--dark .p-threads_flexpane__read_divider__label{color:#5be3a2 !important;}",
    "input[type=checkbox],input[type=radio],progress{accent-color:#2aa96c !important;}",
    ".c-mrkdwn__code,.c-texty_input code,.c-wysiwyg_container--theme_dark code,.c-pillow_file__post__content code{color:#9be9bd !important;}",
    "::selection{background:rgba(42,169,108,0.44) !important;color:#ffffff !important;}",
    ".p-about_modal__contents{background:#101d14 !important;border:1px solid rgba(42,169,108,0.22) !important;}",
    ".p-threads_view{background:#0b120d !important;}",
    ".p-drafts_page,.p-sent_page{background:#0d1710 !important;}",
    "*{scrollbar-color:#245a39 transparent;scrollbar-width:thin;}",
    "*::-webkit-scrollbar-thumb{background:#245a39;border-radius:999px;}",
    "*::-webkit-scrollbar-thumb:hover{background:#2aa96c;}"
  ]
}
